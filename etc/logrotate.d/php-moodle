# Log PHP in /var/log/php (error log FPM/CLI e slowlog del pool)
# La directory DEVE essere di root e non scrivibile da www-data:
#   install -d -o root -g adm -m 0755 /var/log/php
# logrotate gira come root: in una directory scrivibile da un utente non privilegiato
# rifiuta di ruotare ("insecure permissions") ed e' esposto ad attacchi via symlink.
# I file di log sono di www-data (vedi "create"), la directory no.
/var/log/php/*.log {
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    create 0640 www-data adm
    sharedscripts
    postrotate
        if [ -x /usr/lib/php/php8.3-fpm-reopenlogs ]; then
            /usr/lib/php/php8.3-fpm-reopenlogs;
        fi
    endscript
}
